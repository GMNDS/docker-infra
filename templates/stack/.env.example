# Identificação e roteamento
STACK_NAME=minha_app
APP_DOMAIN=app.example.com
APP_PORT=8080

# Fixe uma versão ou digest. Não use `latest` em produção.
APP_IMAGE=example/app:1.0.0

# Nó que possui o volume persistente.
NODE_HOSTNAME=manager-01

# Execução e recursos
TZ=America/Sao_Paulo
APP_REPLICAS=1
APP_CPU_LIMIT=0.50
APP_MEMORY_LIMIT=512M
APP_MEMORY_RESERVATION=128M
