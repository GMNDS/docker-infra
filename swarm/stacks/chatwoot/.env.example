# Carregue este arquivo no shell antes de executar `docker stack deploy`.
# Copie para `.env`; o arquivo real é ignorado pelo Git.

CHATWOOT_DOMAIN=chat.example.com
CHATWOOT_HELP_DOMAIN=help.example.com
CHATWOOT_INSTALLATION_NAME=Minha Empresa
CHATWOOT_LOCALE=pt_BR
CHATWOOT_MAILER_SENDER="Chatwoot <chatwoot@example.com>"
CHATWOOT_SMTP_DOMAIN=example.com
CHATWOOT_SMTP_ADDRESS=smtp.example.com
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_USERNAME=chatwoot@example.com

EVOLUTION_DOMAIN=evolution.example.com
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_WEBHOOK_TOKEN=troque-por-um-token-forte
# Use senha percent-encoded nas URIs caso ela contenha caracteres reservados.
EVOLUTION_DATABASE_URI=postgresql://postgres:senha@postgres:5432/evolution
EVOLUTION_CHATWOOT_DATABASE_URI=postgresql://postgres:senha@postgres:5432/chatwoot?sslmode=disable
